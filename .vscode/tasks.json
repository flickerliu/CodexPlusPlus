{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo: build launcher",
      "type": "process",
      "command": "cargo",
      "args": [
        "build",
        "--package",
        "codex-plus-launcher",
        "--bin",
        "codex-plus-plus",
        "--target-dir",
        "${workspaceFolder}\\target"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$rustc",
      "group": "build"
    }
  ]
}
